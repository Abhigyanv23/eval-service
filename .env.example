# Copy to .env and fill in what you use. docker compose reads this file too.

# Judge used when a request doesn't name one: heuristic | anthropic | openai | local
EVALSVC_DEFAULT_JUDGE=heuristic
EVALSVC_ANTHROPIC_MODEL=claude-opus-5-5
EVALSVC_OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: require an X-API-Key header on every request
EVALSVC_API_KEY=

# Local dev (no docker): SQLite + in-process queue are the defaults.
# EVALSVC_DATABASE_URL=sqlite:///./evalsvc.db
# EVALSVC_REDIS_URL=redis://localhost:6379/0
